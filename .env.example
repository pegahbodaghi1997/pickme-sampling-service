SAMPLER_CONFIG=configs/example.yaml
AUTH_ENABLED=false
# APP_USERS_JSON={"analyst":{"password_hash":"sha256_hash_here","roles":["all"]}}

ANALYTICS_DB_ENGINE=clickhouse
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=8123
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=default
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_SECURE=false

# For PostgreSQL, set ANALYTICS_DB_ENGINE=postgres and usually port 5432.
